{
  "expo": {
    "name": "ARJ",
    "slug": "arj",
    "version": "1.0.0",
    "orientation": "portrait",
    "sdkVersion": "52.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f1f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arj.career"
    },
    "android": {
      "package": "com.arj.career",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f1f"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "extra": {
      "apiUrl": "http://192.168.1.7:4000/api"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
