<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Development: Allow HTTP (cleartext) to any local/private network address.
        This covers:
          - Android Emulator  : 10.0.2.2
          - Physical Device   : any 192.168.x.x or 10.x.x.x WiFi address
          - USB Hotspot       : 192.168.x.x
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
