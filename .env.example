# ========================================================
# CAREER AI (ARJ) — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# --------------------------------------------------------
# 1. SERVER CONFIGURATION
# --------------------------------------------------------
NODE_ENV=production
PORT=4000
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# --------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# --------------------------------------------------------
# Required in production! Generate a secure secret string.
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# --------------------------------------------------------
# 3. SUPABASE DATABASE & ROW LEVEL SECURITY (RLS)
# --------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional MongoDB Connection String (Fallback to JSON DB if unconfigured)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/arj_db

# --------------------------------------------------------
# 4. AI ENGINES & PROVIDERS
# --------------------------------------------------------
# OpenAI API Key for GPT-based resume, cover letter, & mock test scoring
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# RapidAPI Key for JSearch real-time job scraping
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# --------------------------------------------------------
# 5. OAUTH AUTHENTICATION PROVIDERS
# --------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --------------------------------------------------------
# 6. SMTP EMAIL DELIVERY CONFIGURATION
# --------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_smtp_password_here
SMTP_FROM="Career AI <noreply@yourdomain.com>"
